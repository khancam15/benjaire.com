// Cloudflare Workers deployment (ADR-0002, ADR-0004).
// Static pages are served straight from ./dist. Only /api/* reaches the
// Worker script (the contact-form handler). Clean URLs: /about serves
// about.html and /about.html redirects to /about. No routes or custom
// domains here: benjaire.com stays on GitHub Pages until the M6 cutover.
//
// Secrets (set in the dashboard, never in this public repo):
//   TURNSTILE_SECRET_KEY  Turnstile secret for the contact form
//   CONTACT_TO            verified Email Routing destination for inquiries
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benjaire-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Preview addresses: <name>.<account>.workers.dev for main, plus a
  // per-branch preview URL for pull requests. Search engines are pointed at
  // benjaire.com by each page's canonical tag.
  "workers_dev": true,
  "preview_urls": true,
  // Keep Worker logs (contact-form errors) in the dashboard. Free tier.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MAIL_FROM": "website@benjaire.com",
    "ALLOWED_HOSTS": "benjaire.com,www.benjaire.com,benjaire-com.benjaireco.workers.dev"
  },
  // Cloudflare Email Routing: may only send to verified destination addresses.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // 5 submissions per minute per visitor IP.
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
