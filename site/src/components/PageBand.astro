---
// Wide Pavilion render at the foot of an inner page header. Every page uses a
// different camera angle of the same structure as the homepage hero, so the
// site reads as one place. Images live in src/assets/pages/.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props { src: ImageMetadata; alt: string; focus?: 'center' | 'right' }
const { src, alt, focus = 'center' } = Astro.props;
---
<figure class="page-band" data-focus={focus}>
  <Picture src={src} formats={['avif', 'webp']} widths={[800, 1400, 2000]} sizes="(min-width: 1320px) 1208px, 92vw" alt={alt} fetchpriority="high" loading="eager" />
</figure>

<style>
  .page-band { margin: clamp(48px, 6vw, 80px) 0 0; aspect-ratio: 21 / 9; border-radius: 4px; overflow: hidden; background: var(--surface); max-width: 100%; }
  .page-band :global(picture), .page-band :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* No inline styles (strict CSP): the crop focus is a data attribute. */
  .page-band[data-focus='right'] :global(img) { object-position: 68% 50%; }
  @media (max-width: 700px) { .page-band { aspect-ratio: 4 / 3; } }
</style>
