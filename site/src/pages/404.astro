---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page isn't on benjaire.com. The link may be old or mistyped. Go to the homepage or contact Benjaire." noindex>
  <section class="page-head no-rule">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>This page doesn't exist.</h1>
      <p class="lead mb-5">The link may be old, or the address may have a typo.</p>
      <div class="actions"><a class="btn primary" href="/">Go to the homepage</a><a class="btn ghost" href="/contact">Contact Benjaire</a></div>
    </div>
  </section>
</Base>
