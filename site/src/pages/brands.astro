---
import Base from '../layouts/Base.astro';
import BrandGrid from '../components/BrandGrid.astro';
---
<Base title="Brands" seoTitle="Consumer Brands | Benjaire" pageType="CollectionPage" description="Benjaire's consumer brands, now in research and development across consumer technology, accessories, lifestyle products and ecommerce, each under its own name.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Our brands</p>
      <h1>Consumer Brands.</h1>
      <p class="lead">Developing consumer brands through technology, design, and thoughtful product innovation. Consumer Brands is one of Benjaire's two business pillars, and our first brands are in research and development across consumer technology, technology accessories, lifestyle products and ecommerce.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap"><BrandGrid /></div>
  </section>
  <section class="sec raised band-section" aria-labelledby="how-portfolio">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">How the portfolio works</p><h2 id="how-portfolio">One owner, separate brands.</h2></div>
        <p class="muted">A brand joins this page when it publicly launches with its own name, identity and website. Every brand listed here is developed, owned and operated by Benjaire. <a href="/about">How Benjaire works</a></p>
      </div>
      <ul class="rows">
        <li class="row"><h3>Consumer technology</h3><p>Devices and technology accessories for everyday use.</p></li>
        <li class="row"><h3>Lifestyle</h3><p>Everyday products shaped by modern design.</p></li>
        <li class="row"><h3>Ecommerce</h3><p>Brands sold directly online under their own names.</p></li>
      </ul>
      <div class="actions mt-4"><a class="btn ghost" href="/contact?category=supplier#inquiry">Send a supplier inquiry</a></div>
    </div>
  </section>
</Base>
