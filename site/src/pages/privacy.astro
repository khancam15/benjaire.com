---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy Policy" noindex>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="lead">This policy is being finalized and will be published before the new site launches.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <p>Until then: when you email Benjaire, we use your details only to respond to your inquiry. We don't sell personal information.</p>
      <p>Questions about privacy can be sent to <a href="mailto:contact@benjaire.com">contact@benjaire.com</a>.</p>
    </div>
  </section>
</Base>
