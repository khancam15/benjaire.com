---
// Homepage, design v0.3 "The Pavilion" (approved 2026-10-14). Digital first
// positioning (2026-10-14): one company, two pillars (Digital Solutions and
// Consumer Brands). Digital Solutions leads; no separate division branding.
// Layout styles: src/styles/home.css. Interactions: src/scripts/home.ts.
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrandGrid from '../components/BrandGrid.astro';
import OwnerAlert from '../components/OwnerAlert.astro';
import ModelVisual from '../components/ModelVisual.astro';
import { SITE, CATEGORIES, FLOW_CHECKOUT } from '../site';
import '../styles/home.css';
import reflection from '../assets/home/reflection.jpg';

// Build → Operate → Grow is a real sequence, so it is numbered.
const STEPS = [
  { id: 'build', name: 'Build', role: 'Solutions and brands', form: 'From brief to launch',
    text: 'We develop technology solutions for businesses and consumer brands, from research and design to launch.',
    spec: ['Research', 'Design', 'Product', 'Launch'] },
  { id: 'operate', name: 'Operate', role: 'Systems and delivery', form: 'Systems that run daily',
    text: 'We run lean, repeatable systems to deliver services and manage operations, from client projects to sourcing and partnerships.',
    spec: ['Service delivery', 'Operations', 'Sourcing', 'Automation'] },
  { id: 'grow', name: 'Grow', role: 'Validation and expansion', form: 'Proof before scale',
    text: 'We validate demand before investing, strengthen what works and expand into new services, markets and product categories.',
    spec: ['Validation', 'Ongoing support', 'New categories'] },
];

// Benjaire Flow v1.0, the first Digital Solutions product (see /digital/flow).
// Only list what v1.0 actually does.
const FLOW = ['Inquiry capture', 'Sorted by Claude', 'One tap status', 'Reply reminders', 'Monday digest'];

const FOCUS = [
  { name: 'Consumer technology', text: 'Accessories and devices that fit seamlessly into everyday life.' },
  { name: 'Digital', text: 'Online products and experiences designed for how people live and work today.' },
  { name: 'Lifestyle', text: 'Products and brands that bring modern design to the everyday.' },
];

const hasBrands = (await getCollection('brands')).some((e) => e.data.featured);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base hero>
  <ol class="rail" aria-hidden="true">
    {['hero', 'digital', 'philosophy', 'model', 'focus', 'portfolio', 'partner'].map((s, i) => <li data-rail={s} class={i === 0 ? 'on' : undefined}></li>)}
  </ol>

  <!-- 1 · Hero: inquiries (lines of light) are sorted and land in one owner alert -->
  <section class="hero" id="hero" data-section="hero" aria-labelledby="hero-title">
    <canvas class="hero-signal" data-signal aria-hidden="true"></canvas>
    <div class="hero-pane" aria-hidden="true"></div>
    <div class="wrap hero-ui">
      <div class="hero-copy">
        <p class="eyebrow reveal">Digital Solutions · New York · Est. {SITE.founded}</p>
        <h1 id="hero-title" class="reveal">Building brands. <span>Powering businesses.</span></h1>
        <p class="lead hero-lead reveal">Benjaire builds workflow automation for service firms. Our first product, Benjaire Flow, sorts every website inquiry with Claude and hands you one email you can act on with a tap.</p>
        <div class="actions reveal">
          <a class="btn primary" href="/digital/flow">Meet Benjaire Flow <span aria-hidden="true">→</span></a>
          <a class="btn ghost" href="/digital">Explore Digital Solutions</a>
        </div>
        <dl class="hero-proof reveal">
          <div><dt>Ready-made workflows</dt><dd>6</dd></div>
          <div><dt>Typical first setup</dt><dd>45–90 min</dd></div>
          <div><dt>One time, from</dt><dd>$79</dd></div>
        </dl>
      </div>
      <OwnerAlert class="hero-alert" />
    </div>
    <p class="wrap hero-legend" aria-hidden="true"><span><i></i>Inquiries arriving</span><span><i class="sorted"></i>Sorted by Flow</span></p>
  </section>

  <!-- 2 · Digital Solutions -->
  <section class="sec digital" id="digital" data-section="digital" aria-labelledby="digital-title">
    <div class="wrap grid-2">
      <p class="eyebrow">Digital Solutions</p>
      <div>
        <h2 id="digital-title">Smarter systems. <span>Better business.</span></h2>
        <div class="philo-foot">
          <p>Benjaire develops intelligent workflow automation solutions that simplify everyday business operations, reduce repetitive administrative tasks, and support more efficient client experiences.</p>
          <a class="link" href="/digital">Explore Digital Solutions <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="plinth night">
        <div class="glass plinth-card">
          <span class="badge">Available now</span>
          <p class="mono">Benjaire Flow · From $79</p>
          <h3>Every inquiry, answered on time.</h3>
          <p>The inquiry system for service firms. Flow checks each website inquiry, sorts it with Claude and sends it to you with a suggested reply and one tap status buttons. The sender gets a branded acknowledgement, and nothing waits too long.</p>
          <ul class="spec">{FLOW.map((x) => <li>{x}</li>)}</ul>
          <div class="actions">
            <a class="btn primary" href="/digital/flow">Meet Benjaire Flow <span aria-hidden="true">→</span></a>
            {FLOW_CHECKOUT.starter && <a class="btn ghost" href={FLOW_CHECKOUT.starter} rel="noopener">Get Starter · $79</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Philosophy -->
  <section class="sec philosophy" id="philosophy" data-section="philosophy" aria-labelledby="philosophy-title">
    <div class="wrap grid-2">
      <p class="eyebrow">What we do</p>
      <div>
        <h2 id="philosophy-title" class="h-statement">
          {'One company. Two pillars, built on one shared foundation.'.split(' ').map((w) => <span>{w} </span>)}
        </h2>
        <div class="philo-foot">
          <p>Benjaire develops digital solutions for businesses and consumer brands for everyday life. Both share the same standards, systems and name, and we validate demand before we expand.</p>
          <a class="link" href="/about">How Benjaire works <span aria-hidden="true">→</span></a>
        </div>
        <dl class="h-facts">
          <div><dt class="mono">Founded</dt><dd>{SITE.founded}</dd></div>
          <div><dt class="mono">Based in</dt><dd>New York</dd></div>
          <div><dt class="mono">Pillars</dt><dd>Two</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 4 · Build, Operate, Grow -->
  <section class="sec model" id="model" data-section="model" aria-labelledby="model-title">
    <div class="wrap">
      <div class="h-head">
        <p class="eyebrow">Operating model</p>
        <h2 id="model-title">Build. Operate. <span>Grow.</span></h2>
      </div>
      <div class="model-grid">
        <ol class="steps">
          {STEPS.map((s, i) => (
            <li class="step" id={s.id} data-step={i}>
              <ModelVisual class="step-img" kind={s.id as 'build' | 'operate' | 'grow'} />
              <p class="mono">{pad(i + 1)} · {s.form}</p>
              <h3>{s.name}</h3>
              <p class="role">{s.role}</p>
              <p>{s.text}</p>
              <ul class="spec">{s.spec.map((x) => <li>{x}</li>)}</ul>
            </li>
          ))}
        </ol>
        <div class="stage" aria-hidden="true">
          <div class="stage-frame night" data-stage data-active="0">
            {STEPS.map((s, i) => (
              <ModelVisual class="stage-img" i={i} kind={s.id as 'build' | 'operate' | 'grow'} />
            ))}
            <div class="stage-tag glass"><span class="mono" data-stage-label>01 · Build</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Focus areas -->
  <section class="sec focus" id="focus" data-section="focus" aria-labelledby="focus-title">
    <div class="wrap">
      <div class="h-head">
        <p class="eyebrow">Focus areas</p>
        <h2 id="focus-title">Consumer technology, digital <span>and lifestyle.</span></h2>
      </div>
      <div class="focus-grid">
        <ul class="index" data-index>
          {FOCUS.map((f, i) => (
            <li class={i === 0 ? 'on' : undefined} data-i={i} tabindex="0">
              <span class="mono">{pad(i + 1)}</span>
              <h3>{f.name}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
        <div class="focus-visual night" aria-hidden="true" data-tilt>

          <div class="glass focus-card">
            <span class="mono" data-focus-count>Category 01 / 03</span>
            <b data-focus-name>{FOCUS[0].name}</b>
            <span data-focus-text>{FOCUS[0].text}</span>
          </div>
        </div>
      </div>
      <p class="muted center-note">Three categories, one standard: modern products, considered design and great experiences. <a href="/brands">Explore the Benjaire portfolio</a></p>
    </div>
  </section>

  <!-- 6 · Portfolio -->
  <section class="sec portfolio" id="portfolio" data-section="portfolio" aria-labelledby="portfolio-title">
    <div class="wrap">
      <div class="h-head">
        <p class="eyebrow">Our brands</p>
        <h2 id="portfolio-title">The <span>portfolio.</span></h2>
      </div>
      {hasBrands ? <BrandGrid featuredOnly headingLevel={3} /> : (
        <div class="plinth">
          <Picture src={reflection} formats={['avif', 'webp']} widths={[900, 1600, 2400]} sizes="100vw" alt="" loading="lazy" />
          <div class="glass plinth-card">
            <span class="badge">Portfolio in development</span>
            <h3>Our first brands are on the way.</h3>
            <p>Benjaire's brands will be announced here as they launch. In the meantime, we welcome conversations with partners, manufacturers and collaborators.</p>
            <a class="btn primary" href="/contact?category=partnership">Start a conversation <span aria-hidden="true">→</span></a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 7 · Inquiry -->
  <section class="partner" id="partner" data-section="partner" aria-labelledby="partner-title">
    <div class="wrap grid-2">
      <div class="partner-intro">
        <img src="/brand/benjaire-monogram-pearl.svg" alt="" width="53" height="56" />
        <p class="eyebrow">Get in touch</p>
        <h2 id="partner-title">Let's simplify <span>your workflow.</span></h2>
        <p>Explore how intelligent automation could improve your business operations. Partnerships, supplier inquiries and general questions start here too.</p>
        <div class="actions">
          <a class="btn primary" href="/contact?category=digital">Discuss your workflow <span aria-hidden="true">→</span></a>
          <a class="btn ghost" href="/contact#book">Book a call</a>
        </div>
        <p class="mono email">{SITE.email}</p>
      </div>
      <ul class="routes">
        {CATEGORIES.map((c, i) => (
          <li><a href={`/contact?category=${c.value}`}><span class="mono">{pad(i + 1)}</span><span>{c.label}</span><span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>
