---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
// Preload the two faces used above the fold so text doesn't re-wrap (layout shift).
import archivoVar from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

interface Props {
  /** Short page name, used for the breadcrumb and the default "<title> | Benjaire" title */
  title?: string;
  /** Full <title> override when the default pattern isn't descriptive enough */
  seoTitle?: string;
  description?: string;
  noindex?: boolean;
  /** schema.org WebPage subtype for this page, e.g. AboutPage, ContactPage */
  pageType?: string;
  /** Homepage: the nav floats over a full-bleed hero image */
  hero?: boolean;
}
const { title, seoTitle, description = SITE.metaDescription, noindex = false, pageType = 'WebPage', hero = false } = Astro.props;
const brandTitle = `${SITE.name} | Brands for the Modern Era`;
const fullTitle = seoTitle ?? (title ? `${title} | ${SITE.name}` : `${SITE.name} | Consumer Technology, Digital and Lifestyle Brands`);
// Share cards carry the tagline on the homepage; other pages share their own title.
const ogTitle = title || seoTitle ? fullTitle : brandTitle;
// Clean URLs: /about (not /about.html), / (not /index.html).
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL('/og/benjaire-og.png', SITE.url).href;

// Organization and WebSite go on every indexable page so each page's
// isPartOf / about references resolve within that page.
const pageLd = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${SITE.url}/#organization`,
          name: SITE.name,
          url: `${SITE.url}/`,
          logo: `${SITE.url}/brand/benjaire-lockup-vertical.svg`,
          description: SITE.description,
          slogan: 'Brands for the Modern Era',
          foundingDate: String(SITE.founded),
          address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
          email: SITE.email,
          contactPoint: { '@type': 'ContactPoint', contactType: 'business inquiries', email: SITE.email, url: `${SITE.url}/contact` },
        },
        { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, publisher: { '@id': `${SITE.url}/#organization` } },
        {
          '@type': pageType,
          '@id': `${canonical}#webpage`,
          url: canonical,
          name: fullTitle,
          description,
          isPartOf: { '@id': `${SITE.url}/#website` },
          about: { '@id': `${SITE.url}/#organization` },
        },
        ...(cleanPath === '/'
          ? []
          : [
              {
                '@type': 'BreadcrumbList',
                itemListElement: [
                  { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
                  { '@type': 'ListItem', position: 2, name: title ?? SITE.name, item: canonical },
                ],
              },
            ]),
      ],
    };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f3f3f1" />
    <link rel="preload" href={archivoVar} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Benjaire: Brands for the modern era" />
    <meta name="twitter:card" content="summary_large_image" />
    {pageLd && <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body class={hero ? 'has-hero' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
